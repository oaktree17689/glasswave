{
  "name": "glasswave",
  "version": "1.0.0",
  "description": "A glass-inspired front-end music player with official embedded playback.",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win nsis portable" },
  "devDependencies": { "electron": "^35.0.0", "electron-builder": "^26.0.12" },
  "build": {
    "appId": "com.glasswave.player",
    "productName": "Glasswave",
    "asar": true,
    "files": ["index.html", "main.js", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }, { "target": "portable", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
